# Copy to .env and fill in. NEVER commit the real .env file.
PORT=8000

# Only if you get "querySrv ECONNREFUSED" on your own network (not needed when deployed):
# DNS_SERVERS=8.8.8.8,1.1.1.1
NODE_ENV=development

# Local MongoDB (docker compose up -d mongo) or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/huddle

# Long random string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Comma-separated list of frontend origins allowed to call the API
CLIENT_ORIGIN=http://localhost:5173

# Optional: enables "Continue with Google". Same Client ID as VITE_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID=

# Optional: enables AI meeting notes. Without it you get a simpler rule-based summary.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: TURN server so calls work behind strict firewalls (comma-separated URLs)
# Example (values come from your Metered.ca dashboard):
# TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
